{
  "name": "joole",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "build:tools": "sh tools/build.sh",
    "gen:entities": "vite-node scripts/gen-entities.ts",
    "e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0",
    "lucide-static": "^1.74.0",
    "nanoid": "^6.0.2",
    "solid-js": "^2.0.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-solid": "^0.20.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
