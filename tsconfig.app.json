{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "outDir": "./.tsbuild/app",
    "tsBuildInfoFile": "./.tsbuild/app.tsbuildinfo"
  },
  "include": [
    "src/main.ts",
    "src/env.d.ts",
    "src/app/**/*",
    "src/render/**/*",
    "src/platform/**/*",
    "src/ui/**/*"
  ],
  "references": [{ "path": "./tsconfig.core.json" }]
}
