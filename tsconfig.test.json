{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "outDir": "./.tsbuild/test",
    "tsBuildInfoFile": "./.tsbuild/test.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.bench.ts",
    "src/**/__tests__/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "references": [
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.workers.json" }
  ]
}
